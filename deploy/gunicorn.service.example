[Unit]
Description=TeamUp Gunicorn
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/teamup_backend
EnvironmentFile=/srv/teamup_backend/.env
ExecStart=/srv/teamup_backend/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=always

[Install]
WantedBy=multi-user.target
